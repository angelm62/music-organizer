# Local filesystem path where the SMB share is mounted -- NOT an smb:// URL, since
# the tool walks it with plain os.path/os.walk. Mount it first (Finder -> Go -> Connect
# to Server -> smb://truenas._smb._tcp.local/Media, or `mount_smbfs`), then point this
# at the mounted path plus the Music subfolder.
LIBRARY_PATH=/Volumes/Media/Music

# Local Ollama server used to parse messy/garbled filenames when tags are missing.
OLLAMA_HOST=http://10.10.10.1:11434
# Must be a model you've already pulled on that Ollama instance (`ollama pull <model>`).
OLLAMA_MODEL=granite4.1:8b
OLLAMA_TIMEOUT=30

# MusicBrainz requires a contact (email or project URL) in the API User-Agent.
# https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_CONTACT=adfada@gmail.com
MUSICBRAINZ_RATE_LIMIT=1.1

# Where to keep the resolution cache (safe to delete; just means re-querying).
CACHE_PATH=.music_organizer_cache.json

EMBED_COVER_ART=true
WRITE_FOLDER_JPG=true
USE_AI_FALLBACK=true
USE_MUSICBRAINZ=true
MIN_MATCH_SCORE=60
